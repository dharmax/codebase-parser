{
  "name": "@dharmax/codebase-parser",
  "version": "0.2.0",
  "description": "Universal, lightweight, and fast multi-language codebase parser for symbols, facts, and notes.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outdir=dist --entry-naming=index.mjs --packages=external --sourcemap=external && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "author": "dharmax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharmax/codebase-parser.git"
  },
  "bugs": {
    "url": "https://github.com/dharmax/codebase-parser/issues"
  },
  "homepage": "https://github.com/dharmax/codebase-parser#readme",
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.3.0"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "oxc-parser": "^0.155.0"
  }
}
