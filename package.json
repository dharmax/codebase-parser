{
  "name": "@dharmax/codebase-parser",
  "version": "0.1.0",
  "description": "Universal, lightweight, and fast multi-language codebase parser for symbols, facts, and notes.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.mjs --bundle --platform=node --format=esm --outfile=dist/index.mjs --sourcemap --external:node:path && tsc src/index.mjs --declaration --emitDeclarationOnly --outDir dist --allowJs"
  },
  "author": "dharmax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharmax/codebase-parser.git"
  },
  "bugs": {
    "url": "https://github.com/dharmax/codebase-parser/issues"
  },
  "homepage": "https://github.com/dharmax/codebase-parser#readme",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  }
}
